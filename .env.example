# Copy to .env and set non-default values locally. Never commit .env.
# The CLI does not auto-load this file. Export AIDE_DATABASE_URL in the shell
# when your PostgreSQL role is not the Cloud default ubuntu@/aide_dev.
POSTGRES_DB=aide_dev
POSTGRES_USER=aide
POSTGRES_PASSWORD=change-me
AIDE_HTTP_PORT=8000
# Host bind for the published application port. Loopback is the default.
AIDE_HTTP_BIND=127.0.0.1
AIDE_CSRF_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Native local PostgreSQL only. Compose does not publish PostgreSQL to the host.
# AIDE_DATABASE_URL=postgresql+psycopg://aide:change-me@127.0.0.1:5432/aide_dev
# HTTP demo is disabled by default. The CLI demo does not need a token.
AIDE_SYNTHETIC_DEMO_HTTP=0
# Required when AIDE_SYNTHETIC_DEMO_HTTP=1. Leave unset for CLI-only use.
# AIDE_SYNTHETIC_DEMO_TOKEN=
# Public bind is intentional. HTTP demo still requires AIDE_SYNTHETIC_DEMO_TOKEN.
# AIDE_HTTP_BIND=0.0.0.0
